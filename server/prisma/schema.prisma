generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SplitType {
  EQUAL       // Split equally among participants
  PERCENTAGE  // Split by percentage (must sum to 100%)
  EXACT       // Exact amount specified (must sum to total)
}

model Friend {
  id               String          @id @default(uuid())
  name             String
  friendCode       String          @unique @default(cuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  participants     Participant[]
  paymentsOwed     PaymentRecord[] @relation("PaymentsOwed")
  paymentsReceived PaymentRecord[] @relation("PaymentsReceived")
  groupMemberships GroupMember[]

  @@map("friends")
}

model Session {
  id           String        @id @default(uuid())
  name         String
  groupId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  participants Participant[]
  items        Item[]

  @@index([groupId])
  @@map("sessions")
}

model Participant {
  id              String            @id @default(uuid())
  sessionId       String
  friendId        String?
  name            String
  createdAt       DateTime          @default(now())
  session         Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  friend          Friend?           @relation(fields: [friendId], references: [id], onDelete: SetNull)
  itemsPaid       Item[]            @relation("PaidBy")
  itemSplits      ItemSplit[]
  expensePayments ExpensePayment[]

  @@index([sessionId])
  @@index([friendId])
  @@map("participants")
}

model Item {
  id          String            @id @default(uuid())
  sessionId   String
  description String
  totalAmount Decimal           @db.Decimal(10, 2)
  paidById    String?
  createdAt   DateTime          @default(now())
  session     Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  paidBy      Participant?      @relation("PaidBy", fields: [paidById], references: [id])
  splits      ItemSplit[]
  payments    ExpensePayment[]

  @@index([sessionId])
  @@map("items")
}

model ItemSplit {
  id            String      @id @default(uuid())
  itemId        String
  participantId String
  splitType     SplitType   @default(EXACT)
  share         Decimal     @db.Decimal(10, 2)
  percentage    Decimal?    @db.Decimal(5, 2)
  createdAt     DateTime    @default(now())
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id])

  @@index([itemId])
  @@index([participantId])
  @@map("item_splits")
}

model ExpensePayment {
  id            String      @id @default(uuid())
  itemId        String
  participantId String
  amountPaid    Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id])

  @@index([itemId])
  @@index([participantId])
  @@map("expense_payments")
}

model PaymentRecord {
  id               String   @id @default(uuid())
  debtorFriendId   String
  creditorFriendId String
  amount           Decimal  @db.Decimal(10, 2)
  markedPaidAt     DateTime @default(now())
  note             String?
  debtor           Friend   @relation("PaymentsOwed", fields: [debtorFriendId], references: [id])
  creditor         Friend   @relation("PaymentsReceived", fields: [creditorFriendId], references: [id])

  @@index([debtorFriendId])
  @@index([creditorFriendId])
  @@map("payment_records")
}

model Group {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   GroupMember[]
  sessions  Session[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  friendId  String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  friend    Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([groupId, friendId])
  @@index([groupId])
  @@index([friendId])
  @@map("group_members")
}
